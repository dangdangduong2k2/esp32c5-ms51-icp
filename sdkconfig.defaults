CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_MS51_DEBUG_UART_ENABLE=y
CONFIG_MS51_DEBUG_UART_BAUD=115200
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_MS51_WIFI_SSID="MS51-PROGRAMMER"
CONFIG_MS51_WIFI_PASSWORD="12345678"
CONFIG_MS51_WIFI_CHANNEL=1
CONFIG_MS51_WIFI_TX_POWER_QDBM=8
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_MS51_RST_GPIO=3
CONFIG_MS51_CLK_GPIO=0
CONFIG_MS51_DAT_GPIO=1
CONFIG_MS51_ANALOG_IO5=y
CONFIG_MS51_NTC_50K_IO4=y
CONFIG_MS51_NTC_20K_IO6=y
CONFIG_MS51_BIT_DELAY_US=20
CONFIG_MS51_PROGRAM_RETRIES=2

# Connected ESP32-C5 board has 16 MiB external flash.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

CONFIG_LWIP_SNTP_MAX_SERVERS=3

CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
# One peripheral connection, acknowledged chunks; no queued long-write workflow.
CONFIG_BT_NIMBLE_ATT_MAX_PREP_ENTRIES=4
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=2
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=16
# Prefer enough RAM for BLE + TLS + firmware updates over bulk Wi-Fi throughput.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
